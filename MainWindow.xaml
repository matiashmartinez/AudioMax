<Window x:Class="AudioTwin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioTwin Pro v1.2.2" Height="680" Width="950" Background="Black" ResizeMode="CanMinimize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="AudioTwin Pro v1.2.2" Foreground="#DEFF9A" FontSize="28" FontWeight="Bold" Margin="0,0,0,15" Grid.Row="0"/>

        <!-- Entrada -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Dispositivo de entrada (Cable Virtual):" Foreground="White" FontSize="14"/>
            <ComboBox x:Name="InDev" Height="35" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Salidas con Estilo de Lista Oscuro y Slider en Tiempo Real -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Altavoces de salida físicos (Sincronización, Volumen y Batería):" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
            <ListView x:Name="OutDevs" Height="190" Background="#1E1E1E" Foreground="White" BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="4">
                                        <GridViewRowPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Hover sutil y legible -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                        </Trigger>
                                        <!-- Selección elegante -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#333A2E"/>
                                            <Setter Property="TextElement.Foreground" Value="#DEFF9A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Usar" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Dispositivo de Audio" Width="330" DisplayMemberBinding="{Binding FriendlyName}"/>

                        <GridViewColumn Header="Batería" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BatteryStatus}" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Retardo (ms)" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75" HorizontalAlignment="Left" Background="#2D2D2D" Foreground="#DEFF9A" FontWeight="Bold" TextAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Volumen (Tiempo Real)" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Minimum="0" Maximum="100" Width="120" Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                ValueChanged="Slider_VolumeChanged"/>
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:N0}%}" 
                                                   Foreground="#DEFF9A" Width="35" VerticalAlignment="Center" 
                                                   TextAlignment="Right" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <!-- Switch Auto-Sync -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
            <CheckBox x:Name="ChkAutoSync" IsChecked="True" Content=" Activar Auto-Sincronización por silencio (Anti-Desfase Bluetooth)" Foreground="#DEFF9A" FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="▶ Aplicar" Click="Apply_Click" 
                    Background="#DEFF9A" Foreground="Black" Height="40" Width="120" FontSize="16" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="⏹ Detener" Click="Stop_Click" 
                    Background="#FF5555" Foreground="White" Height="40" Width="120" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <!-- Logs -->
        <StackPanel Grid.Row="5">
            <TextBlock Text="Registro de actividad:" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
            <ListBox x:Name="LogList" Background="#1E1E1E" Foreground="#B0B0B0" 
                     FontFamily="Consolas" FontSize="12" Height="90" 
                     HorizontalContentAlignment="Stretch" BorderThickness="0"/>
        </StackPanel>

        <!-- Estado -->
        <StatusBar Grid.Row="6" Background="#2D2D2D" Foreground="#DEFF9A">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Listo."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>